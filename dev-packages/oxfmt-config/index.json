{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 140,
  "tabWidth": 4,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "arrowParens": "avoid",
  "trailingComma": "none",
  "endOfLine": "lf",
  "sortPackageJson": true,
  "overrides": [
    {
      "files": ["*.json", "*.jsonc", "*.yml"],
      "options": {
        "printWidth": 100,
        "tabWidth": 2
      }
    }
  ]
}
