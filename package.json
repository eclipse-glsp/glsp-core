{
  "name": "parent",
  "version": "2.9.0-next",
  "private": true,
  "scripts": {
    "build": "pnpm compile && pnpm bundle",
    "bundle": "pnpm -r run bundle",
    "bundle:browser": "pnpm standalone bundle:browser",
    "bundle:site": "pnpm bundle:browser && pnpm mcp-demo build && node ./scripts/assemble-site.mjs",
    "check:all": "pnpm build && pnpm lint && pnpm format:check && pnpm headers:check && pnpm test && pnpm e2e test",
    "clean": "pnpm -r run clean && rimraf coverage dist-site *.tsbuildinfo",
    "cli": "pnpm -C dev-packages/cli",
    "compile": "tsc -b",
    "dev": "pnpm standalone dev",
    "dev:browser": "pnpm standalone dev:browser",
    "dev:server:socket": "pnpm server dev:socket",
    "e2e": "pnpm -C e2e/workflow-e2e",
    "fix:all": "pnpm lint:fix && pnpm format && pnpm headers:fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:index": "pnpm -r generate:index && pnpm lint:fix",
    "headers:check": "glsp checkHeaders .",
    "headers:fix": "glsp checkHeaders . --autoFix",
    "lint": "oxlint .",
    "lint:ci": "node ./scripts/lint-report.mjs",
    "lint:fix": "pnpm lint --fix",
    "mcp-demo": "pnpm -C examples/workflow-server-mcp-demo",
    "publish:latest": "glsp releng publish latest",
    "publish:next": "glsp releng publish next",
    "server": "pnpm -C examples/workflow-server",
    "standalone": "pnpm -C examples/workflow-standalone",
    "test": "pnpm compile && vitest run",
    "test:cli:e2e": "pnpm cli test:e2e",
    "test:client": "pnpm test --project client",
    "test:common": "pnpm test --project common",
    "test:coverage": "pnpm compile && vitest run --coverage",
    "test:dev": "pnpm test --project dev",
    "test:e2e": "pnpm build && pnpm e2e test",
    "test:e2e:standalone": "pnpm build && pnpm e2e test:standalone",
    "test:e2e:standalone-browser": "pnpm build && pnpm e2e test:standalone-browser",
    "test:server": "pnpm test --project server",
    "upgrade:next": "glsp updateNext"
  },
  "devDependencies": {
    "@eclipse-glsp/dev": "workspace:*",
    "@types/node": "24.x",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "reflect-metadata": "^0.2.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.4.0"
}
