# Optional local overrides for the e2e test run. Copy to `e2e/.env` and adjust as needed;
# every value below is the built-in default.

# ── GLSP server ──────────────────────────────────────────────────────────────
# Port of the Workflow GLSP server (Node mode).
GLSP_SERVER_PORT=8081

# Server implementation the tests assert against: `node` or `java`. Some labels and popup texts
# differ between the two. The Java server lives in the separate `glsp-server` repository and is
# never started by Playwright — start it yourself before running the tests.
GLSP_SERVER_TYPE=node

# Set to `true` to run against a Workflow GLSP server you started yourself, instead of the one
# from `examples/workflow-server`. Implied by `GLSP_SERVER_TYPE=java`.
# GLSP_SERVER_EXTERNAL=true

# ── Client ports ─────────────────────────────────────────────────────────────
# STANDALONE_PORT=8082
# STANDALONE_BROWSER_PORT=8083
