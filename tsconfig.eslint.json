{
  "extends": "@eclipse-glsp/ts-config",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "packages/*/*/src",
    "examples/*/src",
    "dev-packages/*/src",
    "dev-packages/*/tests",
    "dev-packages/*/vite.config*.ts",
    "e2e/*/src",
    "e2e/*/tests",
    "e2e/*/configs/*.ts",
    "e2e/*/playwright.config.ts",
    "vite.config.ts"
  ]
}
