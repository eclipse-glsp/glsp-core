{
  "name": "@eclipse-glsp-examples/playground-server",
  "version": "2.9.0-next",
  "private": true,
  "description": "GLSP server for the playground example, hosting all example languages",
  "keywords": [
    "diagram",
    "example",
    "glsp",
    "playground"
  ],
  "homepage": "https://www.eclipse.org/glsp/",
  "bugs": "https://github.com/eclipse-glsp/glsp/issues",
  "license": "(EPL-2.0 OR GPL-2.0 WITH Classpath-exception-2.0)",
  "author": {
    "name": "Eclipse GLSP"
  },
  "contributors": [
    {
      "name": "Eclipse GLSP Project",
      "email": "glsp-dev@eclipse.org",
      "url": "https://projects.eclipse.org/projects/ecd.glsp"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse-glsp/glsp-core.git",
    "directory": "examples/playground-server"
  },
  "scripts": {
    "build": "tsc -b && pnpm bundle",
    "bundle": "node esbuild.js",
    "clean": "rimraf lib dist *.tsbuildinfo",
    "dev": "node esbuild.js --watch --run-node -- -w --port 8081",
    "start": "node --enable-source-maps dist/playground-server-node.js -w --port 8081"
  },
  "dependencies": {
    "@eclipse-glsp-examples/gmodel-demo-server": "workspace:*",
    "@eclipse-glsp-examples/workflow-server": "workspace:*",
    "@eclipse-glsp/layout-elk": "workspace:*",
    "@eclipse-glsp/server": "workspace:*",
    "@eclipse-glsp/server-mcp": "workspace:*",
    "inversify": "^6.1.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "esbuild": "~0.28.0"
  }
}
